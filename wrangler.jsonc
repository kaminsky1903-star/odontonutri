{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "odontonutri",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist/client",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "odontonutri.com", "custom_domain": true },
    { "pattern": "www.odontonutri.com", "custom_domain": true }
  ],
  "observability": {
    "enabled": true
  }
}
